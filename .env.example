NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Khoá mã hoá credentials hoá đơn điện tử MISA (AES-256-GCM).
# Sinh 32 byte ngẫu nhiên: `openssl rand -hex 32` hoặc `openssl rand -base64 32`.
# BẮT BUỘC cho production — nếu rotate sẽ mất khả năng giải mã credentials cũ.
EINVOICE_ENC_KEY=

# Service role key (Supabase Dashboard > Settings > API). SERVER-ONLY —
# tuyet doi khong dat vao bien NEXT_PUBLIC_*. Can cho: tao/xoa nhan vien,
# dang nhap bang ma QR.
SUPABASE_SERVICE_ROLE_KEY=

# URL cong khai cua app — dung de sinh link trong ma QR dang nhap.
# Mac dinh: https://nppsale.vercel.app
NEXT_PUBLIC_APP_URL=

# Bi mat cho cac route chay theo lich. vercel.json khai DUNG MOT cron:
#   /api/cron/daily  "0 18 * * *"  (18:00 UTC = 01:00 sang gio VN hom sau)
# Route do goi lan luot: dong bo hoa don MISA -> nhac anh diem ban (chi thu
# Hai gio VN) -> keo snapshot hoa don. Goi tay tung endpoint rieng van chay.
# Goi Hobby cua Vercel khong nhan lich day hon mot lan moi ngay — khai day
# hon thi Vercel TU CHOI tao ban deploy va khong hien loi nao.
# Sinh: `openssl rand -hex 32`. Dat trong Vercel > Settings > Environment
# Variables; Vercel Cron tu gan header `Authorization: Bearer $CRON_SECRET`.
# Dat xong phai DEPLOY LAI thi bien moi co hieu luc.
# Route dung admin client (bo qua RLS) nen day la hang rao DUY NHAT —
# THIEU bien nay thi route tu tat (503), khong mo cua.
CRON_SECRET=

# Bat che do bao tri: chan moi lan tai trang moi, hien "Dang nang cap he
# thong". Gia tri bat: 1 / true / on. Moi gia tri khac (ke ca "false") la
# TAT. Doi bien nay phai DEPLOY LAI thi middleware moi doc duoc.
#
# CANH BAO: khong chan duoc mot tab DANG MO SAN — ma trong tab do noi
# thang voi Supabase, khong di qua may chu Next.js. Xem docs/bao-tri.md.
MAINTENANCE_MODE=
