# Xuống dòng LF cho script / workflow / mã nguồn — CRLF làm bash đọc sai từng lệnh
# ("set: +\r: invalid option") và bước kiểm bản sao lưu chết trước khi tải lên Google Drive (08/10/2026).
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.mts  text eol=lf
*.js   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
